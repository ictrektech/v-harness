#!/usr/bin/env bash
# Container entrypoint: prepare the shared data root, then hand over to the
# gateway. dsh instances are started on first sign-in, not here.
set -euo pipefail

DATA_ROOT="${DATA_ROOT:-/data}"
STATE_ROOT="${STATE_ROOT:-${DATA_ROOT}/.vh}"

mkdir -p "${DATA_ROOT}" "${STATE_ROOT}"
# 0711: a tenant must traverse the home root to reach its own home, but cannot
# list it. The gateway state lives in one hidden sibling that stays 0700 root.
chmod 0711 "${DATA_ROOT}"
chmod 0700 "${STATE_ROOT}"

# A volume written by an earlier layout keeps the user table at its root.
if [[ -f "${DATA_ROOT}/users.json" && ! -f "${STATE_ROOT}/users.json" ]]; then
  mv "${DATA_ROOT}/users.json" "${STATE_ROOT}/users.json"
fi
chmod 0600 "${STATE_ROOT}/users.json" 2>/dev/null || true

# A gateway killed mid-write leaves zero-length *.tmp snapshots behind. They
# are never read again, and no writer exists this early in the boot, so clearing
# them here keeps the state directory from accumulating garbage.
find "${STATE_ROOT}" -maxdepth 1 -type f \( -name '*.tmp' -o -name '*.tmp-*' \) -size 0 -delete 2>/dev/null || true

# Tenants share the container network, so there is no namespace to rebuild.
# The probe stays: a container whose loopback does not accept a connection
# cannot run an instance, and that is worth failing at startup.
node /opt/v-harness/bin/network-probe.mjs

# Debian resolves `iptables` and `ip6tables` to the nft frontends. A kernel
# built without CONFIG_NFT_CT (the Jetson arm hosts) cannot load the matches
# they emit, so `-m conntrack` fails — and so does `-m mark` — and bin/vh-jail
# refuses to start any tenant with "network isolation failed". The legacy
# frontends reach xt_conntrack and xt_mark, which those kernels do ship. Both
# frontends accept a rule when parsing it, so the only way to tell them apart is
# to have the kernel install it on a throwaway chain; the winner then becomes
# the container-wide default, which also covers the gateway's isolation rules.
frontend_rule_works() {
  local frontend="$1"; shift
  local chain="vh-boot-probe-$$" rc=0
  "$frontend" -N "$chain" 2>/dev/null || return 1
  "$frontend" -A "$chain" "$@" 2>/dev/null || rc=1
  # A leftover probe chain is harmless, but silently leaving one makes a
  # container that could not clean up after itself indistinguishable from one
  # that never ran the check.
  "$frontend" -F "$chain" 2>/dev/null \
    || echo "boot probe: could not flush $chain for $frontend" >&2
  "$frontend" -X "$chain" 2>/dev/null \
    || echo "boot probe: could not delete $chain for $frontend" >&2
  return "$rc"
}
# Exactly the conntrack and mark matches the jail and the gateway install,
# including the DNS port match from vh-jail's resolver rule.
frontend_matches_work() {
  frontend_rule_works "$1" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT \
    && frontend_rule_works "$1" -p udp -m conntrack --ctorigdstport 53 -j ACCEPT \
    && frontend_rule_works "$1" -m mark --mark 0x1 -j ACCEPT
}
for family in iptables ip6tables; do
  frontend_matches_work "$family" && continue
  if command -v "${family}-legacy" >/dev/null 2>&1 \
     && frontend_matches_work "${family}-legacy"; then
    if update-alternatives --set "$family" "/usr/sbin/${family}-legacy" >/dev/null 2>&1; then
      echo "${family}: switched to the legacy frontend (this kernel cannot load the nf_tables matches)"
    else
      echo "${family}: the legacy frontend works but update-alternatives --set failed; rules are still routed to nft and will fail" >&2
    fi
  else
    echo "${family}: neither frontend can install conntrack/mark on this kernel; network isolation will be unavailable (fail-open)" >&2
  fi
done
# xt_owner is a separate module: docker-proxy's per-tenant rule needs it, but
# the jail's isolation does not. Check the frontend that won above and say so
# instead of letting a missing owner match force a false frontend switch.
for family in iptables ip6tables; do
  frontend_rule_works "$family" -m owner --uid-owner 0 -j ACCEPT \
    || echo "boot probe: $family cannot install the owner match; docker-proxy's per-tenant rule may be skipped" >&2
done

# dsh fails closed when it cannot confine bash: if neither bwrap nor Landlock is
# usable the bash tool refuses to run. Record the verdict at startup so a broken
# container is diagnosed from the log instead of from a user report.
node /opt/v-harness/bin/sandbox-probe.mjs

# Containers have no init loop for the per-user accounts, so rebuild them from
# the durable user table before the gateway can accept a request. The helper is
# idempotent and never touches existing data.
if [[ -f "${STATE_ROOT}/users.json" ]]; then
  DATA_ROOT="$DATA_ROOT" STATE_ROOT="$STATE_ROOT" node -e '
    const { readFileSync, existsSync, renameSync } = require("node:fs");
    const path = "/opt/v-harness/bin/vh-userctl";
    const dataRoot = process.env.DATA_ROOT;
    const table = JSON.parse(readFileSync(`${process.env.STATE_ROOT}/users.json`, "utf8"));
    const { execFileSync } = require("node:child_process");
    for (const record of Object.values(table)) {
      const account = record.account ?? record.linuxName;
      const target = `${dataRoot}/${account}`;
      const legacy = `${dataRoot}/users/${record.namespace}`;
      // One boot moves a home written by the previous layout; later boots find
      // the target already there and leave it alone.
      if (!existsSync(target) && existsSync(legacy)) renameSync(legacy, target);
      execFileSync(path, ["ensure", account, String(record.uid), target], {
        stdio: "inherit",
        env: { ...process.env, HOME_ROOT: dataRoot },
      });
    }
  '
fi

# node:sqlite is flag-gated on Node 22 and stable from Node 24; probe once so
# the same image line runs on either base.
SQLITE_FLAGS=()
if ! node -e "import('node:sqlite').then(() => process.exit(0), () => process.exit(1))" 2>/dev/null; then
  SQLITE_FLAGS=(--experimental-sqlite)
fi
# The supervisor is PID 1 and restarts the gateway itself. Making the gateway a
# child is what lets tenant dsh processes survive a gateway restart; a direct
# exec here would make PID 1's exit tear the whole container down.
export VH_SQLITE_FLAGS="${SQLITE_FLAGS[*]}"
exec /opt/v-harness/bin/vh-supervisor.sh
