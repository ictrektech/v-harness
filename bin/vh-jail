#!/usr/bin/env bash
# Run one tenant's dsh inside a mount + pid + ipc + uts + chroot jail.
#
# The jail layout mirrors an ordinary Linux server:
#
#   /home/<account>     the tenant's own content (bound from the data root)
#   /usr /bin /lib ...  shared runtime, mounted read-only
#   (nothing else)
#
# Everything bound in is an allow-list. The container's /etc, /dev and /proc are
# shared by every tenant, so rbinding a whole directory would hand one tenant
# whatever that directory happens to expose to the others: /etc/passwd lists
# every account, /dev/shm is one writable tmpfs for the whole container. Only the
# named entries below are reachable, and identity files are generated per tenant.
#
# The hostname is set per account so the prompt reads `vh-xxxx@dsh:~` instead of
# exposing the container id, and `cd ..` from the tenant home stops at the
# data root holding only that tenant
# because nothing above it exists.
#
# Requires CAP_SYS_ADMIN plus unconfined seccomp, declared in the app manifest.
#
# Usage: vh-jail <account> <uid> <home> <command...>
set -euo pipefail

HOME_ROOT="${HOME_ROOT:-/data}"
SKILLS_ROOT="${BUNDLED_SKILL_DIR:-/opt/v-harness/skills}"
JAIL_HOSTNAME="${VH_JAIL_HOSTNAME:-dsh}"

die() { printf 'vh-jail: %s\n' "$*" >&2; exit 1; }

[[ "${EUID}" -eq 0 ]] || die 'must run as root'

account="${1:-}"
uid="${2:-}"
home="${3:-}"
shift 3 || die 'usage: vh-jail <account> <uid> <home> <command...>'

[[ "$account" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid account: ${account}"
[[ "$uid" =~ ^[0-9]+$ ]] || die "invalid uid: ${uid}"
[[ "$home" == "${HOME_ROOT}/${account}" ]] || die "home must be ${HOME_ROOT}/${account}: ${home}"
[[ -d "$home" ]] || die "home does not exist: ${home}"

export VH_JAIL_ACCOUNT="$account"
export VH_JAIL_UID="$uid"
export VH_JAIL_HOME="$home"
export VH_JAIL_SKILLS="$SKILLS_ROOT"
export VH_JAIL_HOSTNAME="$JAIL_HOSTNAME"

# --mount-proc gives the pid namespace its own /proc, so `ps` only lists this
# user's processes. --fork is required for --pid to take effect. --ipc drops the
# shared System V / POSIX IPC key space, which would otherwise let two tenants
# attach to the same 0666 shared-memory segment. --uts exists only so the
# hostname below stays inside this session.
# Per-tenant network namespace. Every tenant gets its own loopback, so a service
# on :3000 in one account is invisible to the next, and nothing a tenant starts
# can claim an address the gateway itself uses. The namespace outlives the
# instance: restarting dsh must not kill the services still running inside it.
NETNS_NAME="vh-${account}"
NETNS_PATH="/var/run/netns/${NETNS_NAME}"
mkdir -p /var/run/netns
if [[ ! -e "$NETNS_PATH" ]]; then
  ip netns add "$NETNS_NAME" || die "cannot create network namespace ${NETNS_NAME}"
fi

# pasta (passt) is user-mode networking: outbound access, a DNS forwarder and a
# private loopback, with no bridge, no veth pair and no iptables rule. It is the
# *namespace's* network, not the instance's, so it outlives every jail that
# joins the namespace: a tenant's services keep listening there while dsh
# restarts, and a service restart must not leave the instance unreachable. One
# pasta per namespace, shared by all of its jails.
#
# Both addresses below belong to the gateway, the only side that connects:
#   VH_PREVIEW_IP  the host address this namespace is published on
#   VH_GATEWAY_IP  the address a tenant dials to reach the gateway's loopback
[[ -n "${VH_PREVIEW_IP:-}" ]] || die 'VH_PREVIEW_IP is missing: the gateway must name this tenant address'
[[ -n "${VH_GATEWAY_IP:-}" ]] || die 'VH_GATEWAY_IP is missing: the gateway must name its tenant-visible address'
PREVIEW_IP="$VH_PREVIEW_IP"
export VH_PREVIEW_IP VH_GATEWAY_IP
command -v pasta >/dev/null 2>&1 || die 'pasta is missing from the image'

# Both options below are load-bearing: without --config-net the namespace gets
# no route, and without --dns-forward the resolver in /etc/resolv.conf has no
# upstream. The gateway's loopback needs no flag, because pasta maps the gateway
# address to the host's loopback unless `--no-map-gw` is passed. A pasta too old
# to know these is a broken image, reported as such rather than as a namespace
# that mysteriously never came up.
pasta_help="$(pasta --help 2>&1 || true)"
for option in --config-net --dns-forward; do
  grep -q -- "$option" <<<"$pasta_help" \
    || die "pasta in this image does not support ${option}; the tenant network cannot be published"
done

# Outside /var/run/netns on purpose: `ip netns list` reports every file in that
# directory as a namespace, so a pidfile there would show up as a fake one.
mkdir -p /run/vh-netns
PASTA_PIDFILE="/run/vh-netns/${NETNS_NAME}.pasta.pid"

# The pid holding this namespace's forwards, but only if that pid really is the
# pasta for this namespace: pids are recycled, and trusting a stale number would
# either kill a stranger or leave the namespace without a network.
pasta_pid() {
  local pid
  pid="$(cat "$PASTA_PIDFILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -qF -- "--netns ${NETNS_PATH}" || return 1
  printf '%s\n' "$pid"
}

start_pasta() {
  local -a args=(--foreground --config-net --netns "$NETNS_PATH" -4 --dns-forward 10.0.2.3)
  # pasta drops root for `nobody` unless told which uid to run as, and `nobody`
  # then cannot enter the namespace it was pointed at ("Couldn't switch to pasta
  # namespaces: Operation not permitted"). The jail, not pasta's own uid, is the
  # confinement boundary here, so it keeps the uid that can setns and own the tap.
  args+=(--runas 0:0)
  # A tenant reaches the gateway (model calls, scheduled follow-ups) by dialling
  # "$GATEWAY_IP": pasta maps the gateway address to the host's loopback by
  # default, and the gateway itself keeps listening on that loopback.
  # `--map-host-loopback` is not an upstream option, so passing it only made an
  # otherwise healthy image look broken.
  # The instance's own web port lives inside this namespace: without a forward
  # the gateway has no route to it at all.
  if [[ "${VH_JAIL_PORT:-}" =~ ^[0-9]+$ ]]; then
    args+=(-t "${PREVIEW_IP}/${VH_JAIL_PORT}:${VH_JAIL_PORT}")
  fi
  # Ports a tenant service is expected to listen on. pasta binds every forwarded
  # port eagerly, so the list stays short rather than covering 1-65535.
  local spec
  for spec in 3000-3099 5173-5173 8000-8099 9000-9099; do
    args+=(-t "${PREVIEW_IP}/${spec}:${spec}")
  done
  # 9>&- : the lock stays with the launching jail, not with the daemon it spawns.
  pasta "${args[@]}" >>"/var/log/vh-pasta-${account}.log" 2>&1 9>&- &
  printf '%s\n' "$!" >"$PASTA_PIDFILE"
}

# Two jails of one tenant can start together (dsh and a service restart); the
# lock keeps them from starting two pasta processes for the same forwards.
exec 9>"${PASTA_PIDFILE}.lock"
flock -w 60 9 || die "another launch is starting the network for ${NETNS_NAME}"
if [[ -z "$(pasta_pid)" ]]; then
  start_pasta
fi

# The namespace is only usable once pasta has configured its interface. Running
# without it would silently fall back to the shared container network, which is
# exactly the state this layer exists to end, so the instance refuses to start.
for _ in $(seq 1 100); do
  ip netns exec "$NETNS_NAME" ip route 2>/dev/null | grep -q '^default' && break
  sleep 0.1
done

# Outbound policy. The namespace shares the container's address, so without a
# rule a tenant reaches every service on the platform's own network: the apps
# behind the skills, other instances, the host. The jail needs the gateway and
# the public internet and nothing else, so every directly-connected subnet is
# blackholed. This is deliberately not a per-port allowance: the skills reach
# their backends through unix sockets in the tenant home, never over the wire.
#
# `ip rule` rather than iptables: the image ships neither iptables nor nft, and
# a destination table needs neither. The namespace outlives every jail in it, so
# rules are replaced, not appended.
EGRESS_TABLE=100

# Directly-connected subnets are exactly the platform network. The container has
# one interface; dockerd's bridges live in the host namespace, out of reach.
internal_cidrs() {
  ip -4 -o route show scope link 2>/dev/null \
    | awk '$1 ~ /^[0-9]/ && $1 !~ /^(127|169\.254)\./ { print $1 }'
}

apply_egress_policy() {
  local ns="$NETNS_NAME" cidr
  ip netns exec "$ns" ip route flush table "$EGRESS_TABLE" 2>/dev/null || true
  # Priority 89 carried the retired per-host allow-list. The namespace outlives
  # every jail, so a rule left by an older binary would keep that host open
  # forever; drain it before installing the current policy.
  while ip netns exec "$ns" ip rule del priority 89 2>/dev/null; do :; done
  ip netns exec "$ns" ip rule del priority 90 2>/dev/null || true
  ip netns exec "$ns" ip rule del priority 100 2>/dev/null || true
  for cidr in $(internal_cidrs); do
    ip netns exec "$ns" ip route add blackhole "$cidr" table "$EGRESS_TABLE" 2>/dev/null || true
  done
  # The gateway sits on the internal network and must stay reachable: the tenant
  # dials it for model calls and scheduled follow-ups.
  ip netns exec "$ns" ip rule add to "$VH_GATEWAY_IP" priority 90 lookup main
  # Everything else consults the blackhole table first. Public destinations are
  # absent from it, so the lookup falls through to the main table unchanged.
  ip netns exec "$ns" ip rule add lookup "$EGRESS_TABLE" priority 100
}

apply_egress_policy

flock -u 9
exec 9>&-
if ! ip netns exec "$NETNS_NAME" ip route 2>/dev/null | grep -q '^default'; then
  printf 'vh-jail: pasta did not configure %s; refusing to run without a network\n' "$NETNS_NAME" >&2
  printf 'vh-jail: see /var/log/vh-pasta-%s.log\n' "$account" >&2
  exit 78
fi

ip netns exec "$NETNS_NAME" unshare --mount --pid --ipc --uts --fork --mount-proc bash -c '
  set -euo pipefail
  cd /
  # Keep these mounts inside this namespace; propagating them would corrupt the
  # container for every other user.
  mount --make-rprivate /
  hostname "$VH_JAIL_HOSTNAME" 2>/dev/null || true


  # The jail root is a fresh tmpfs; only what is bound below is reachable.
  root="/run/vh-root-$VH_JAIL_ACCOUNT"
  rm -rf "$root"
  mkdir -p "$root"
  mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$root"

  # Bind one allow-listed entry read-only. Directories are re-bound (not
  # recursively) so an unexpected submount on the host stays out of the jail.
  bind_ro() {
    local source="/$1" target="$root/$1"
    [[ -e "$source" ]] || return 0
    mkdir -p "$(dirname "$target")"
    if [[ -d "$source" ]]; then
      mkdir -p "$target"
      mount --bind "$source" "$target"
    else
      touch "$target"
      mount --bind "$source" "$target"
    fi
    mount -o remount,bind,ro "$target"
  }

  # Public read-only runtime, exactly like a shared server. /usr is one unit
  # because the loader, Node, dsh and its native modules all live under it.
  bind_ro usr

  # Debian merged-/usr layout: /bin, /lib, /lib64 and /sbin are symlinks into
  # /usr. The new root has to recreate them or the dynamic loader is missing.
  for pair in bin:usr/bin lib:usr/lib lib64:usr/lib64 sbin:usr/sbin; do
    name="${pair%%:*}"
    target="${pair#*:}"
    if [[ -e "/$name" ]]; then
      ln -sfn "$target" "$root/$name"
    fi
  done

  # The container /etc is shared with every tenant, so the whole directory never
  # comes in. What is bound are the files a running process genuinely resolves
  # (loader cache, TLS roots, timezone, NSS) and nothing else: no /etc/shadow,
  # no /etc/sudoers, no /etc/ld.so.preload. Identity files are written below.
  mkdir -p "$root/etc"
  for entry in \
    ld.so.cache ld.so.conf ld.so.conf.d alternatives \
    ssl/certs ssl/openssl.cnf \
    nsswitch.conf localtime timezone \
    mime.types services protocols \
    profile profile.d bash.bashrc bash_completion.d inputrc \
    terminfo gitconfig; do
    bind_ro "etc/$entry"
  done
  ln -sfn /proc/mounts "$root/etc/mtab"

  # Identity as this tenant sees it: the account itself, and localhost only.
  # A missing getpwuid entry breaks os.userInfo() and every group lookup, so the
  # tenant must be present; the rest of the container must not be.
  printf "%s:x:%s:%s::/home/%s:/usr/sbin/nologin\n" \
    "$VH_JAIL_ACCOUNT" "$VH_JAIL_UID" "$VH_JAIL_UID" "$VH_JAIL_ACCOUNT" \
    > "$root/etc/passwd"
  printf "%s:x:%s:\n" "$VH_JAIL_ACCOUNT" "$VH_JAIL_UID" > "$root/etc/group"
  printf "%s\n" "$VH_JAIL_ACCOUNT" > "$root/etc/hostname"
  printf "127.0.0.1 localhost\n::1 localhost ip6-localhost ip6-loopback\n" \
    > "$root/etc/hosts"
  chmod 0644 "$root/etc/passwd" "$root/etc/group" "$root/etc/hosts" "$root/etc/hostname"
  # DNS is not a jail concern (the container network is shared by design) but
  # name resolution is required by every model call, so the resolver comes in.
  bind_ro etc/resolv.conf

  # Product skills, read-only, at the path DSH_BUNDLED_SKILL_DIR promises.
  mkdir -p "$root$VH_JAIL_SKILLS"
  mount --bind "$VH_JAIL_SKILLS" "$root$VH_JAIL_SKILLS"
  mount -o remount,bind,ro "$root$VH_JAIL_SKILLS"

  # Devices: a fresh tmpfs with the nodes a process actually needs. The container
  # /dev is shared, and rbinding it would carry /dev/shm (one writable 64MB
  # tmpfs for the whole container) and a view of the pty of every other tenant.
  mkdir -p "$root/dev" "$root/proc" "$root/tmp" "$root/run"
  mount -t tmpfs -o mode=0755,nosuid tmpfs "$root/dev"
  for node in null:1:3 zero:1:5 full:1:7 random:1:8 urandom:1:9 tty:5:0; do
    node_name="${node%%:*}"
    rest="${node#*:}"
    mknod -m 0666 "$root/dev/$node_name" c "${rest%%:*}" "${rest#*:}"
  done
  mkdir -p "$root/dev/pts" "$root/dev/shm"
  # A private devpts instance: ptys allocated inside the jail are numbered here
  # and stay invisible to the host and to other tenants.
  mount -t devpts -o newinstance,ptmxmode=0666,mode=0620,gid=5 devpts "$root/dev/pts"
  ln -sfn pts/ptmx "$root/dev/ptmx"
  # Private scratch, so the classic cross-tenant tmpfs is not shared.
  mount -t tmpfs -o mode=1777,nosuid,nodev,size=64m tmpfs "$root/dev/shm"
  ln -sfn /proc/self/fd "$root/dev/fd"
  ln -sfn /proc/self/fd/0 "$root/dev/stdin"
  ln -sfn /proc/self/fd/1 "$root/dev/stdout"
  ln -sfn /proc/self/fd/2 "$root/dev/stderr"

  # A fresh proc rather than a recursive bind of the container one: the bind
  # would also carry /proc/sys and leave it read-write. Inside the pid namespace
  # this instance lists only this tenant.
  mount -t proc -o nosuid,nodev,noexec proc "$root/proc"


  # Bounded private scratch: an unbounded tmpfs lets one tenant exhaust the
  # container memory and slow every other tenant down — which is itself a way to
  # learn that someone else is there.
  mount -t tmpfs -o mode=1777,nosuid,nodev,size=512m tmpfs "$root/tmp"
  mount -t tmpfs -o mode=0755,nosuid,nodev,size=16m tmpfs "$root/run"
  # pasta answers 10.0.2.3 for this namespace (--dns-forward) and resolves
  # against the container resolver, which the namespace cannot reach directly.
  # Double quotes are load-bearing: this line is inside the `bash -c '...'`
  # body above, so a single quote here would end that body early and the rest
  # of the jail would never run.
  printf "nameserver 10.0.2.3\n" > "$root/run/resolv.conf"
  mount --bind "$root/run/resolv.conf" "$root/etc/resolv.conf"

  # The tenant home at /home/<account>: a private /home means a sibling tenant
  # is not merely unreadable but nonexistent, and nothing creates /data, so a
  # probe of it answers ENOENT instead of a permission error.
  mkdir -p "$root/home/$VH_JAIL_ACCOUNT"
  mount --bind "$VH_JAIL_HOME" "$root/home/$VH_JAIL_ACCOUNT"
  chmod 0700 "$root/home/$VH_JAIL_ACCOUNT"

  # Everything above is root-side setup. The command starts unprivileged and
  # without CAP_SYS_CHROOT, so it cannot climb out of the jail root. The bounding
  # set, inheritable set and ambient set are dropped too: the container runs with
  # SYS_ADMIN and unconfined seccomp for vh-jail itself, and that posture must not
  # be inherited by the tenant. --no-new-privs keeps a setuid binary inside the
  # home from reintroducing privilege.
  exec chroot "$root" /bin/sh -c "
    # Fail closed: if the world below is not the isolated one, do not start at
    # all. A degraded start is indistinguishable from a leak until it is too
    # late, so it is treated as a refusal.
    fail() { printf \"vh-jail: isolation check failed: %s\n\" \"\$1\" >&2; exit 97; }
    [ \"\$(wc -l < /etc/passwd)\" -eq 1 ] || fail \"etc/passwd lists more than one account\"
    [ \"\$(ls /home | wc -l)\" -eq 1 ] || fail \"the home root lists more than one tenant\"
    [ \"\$(ls /home)\" = \"$VH_JAIL_ACCOUNT\" ] || fail \"the home root does not name this tenant\"
    if [ -e /data ]; then fail \"the data root is visible\"; fi
    if [ -e /root ]; then fail \"the root home is visible\"; fi
    export HOME=\"/home/$VH_JAIL_ACCOUNT\"
    export USER=\"$VH_JAIL_ACCOUNT\"
    export LOGNAME=\"$VH_JAIL_ACCOUNT\"
    export HOSTNAME=\"$VH_JAIL_HOSTNAME\"
    # User-level installs land in the tenant home, exactly like a plain server:
    # the system runtime is read-only, so npm/pip/cargo must be pointed at
    # writable prefixes under \$HOME, and those prefixes must be on PATH or the
    # command a tenant just installed is not found.
    export NPM_CONFIG_PREFIX=\"\$HOME/.npm-global\"
    export CONDA_PKGS_DIRS=\"\$HOME/.cache/conda\"
    # Plugins that resolve their store from an XDG root instead of DSH_HOME
    # must land in the tenant home too: a root inherited from the gateway
    # would be one directory shared by every tenant.
    export XDG_CONFIG_HOME=\"\$HOME/.config\"
    export XDG_DATA_HOME=\"\$HOME/.local/share\"
    export XDG_CACHE_HOME=\"\$HOME/.cache\"
    export XDG_STATE_HOME=\"\$HOME/.local/state\"
    export PATH=\"\$HOME/.npm-global/bin:\$HOME/.local/bin:\$HOME/.cargo/bin:\$HOME/.bun/bin:\$HOME/.nvm/current/bin:/usr/local/bin:/usr/bin:/bin\"
    # The tenant gets a real docker CLI pointed at the filtered endpoint the
    # gateway publishes. The host socket itself is never mounted, so this is
    # the only path from here to the daemon; absent when not published. No
    # single quotes in this block: the body is one single-quoted string.
    if [ -S \"\$HOME/.dsh/docker.sock\" ]; then
      export DOCKER_HOST=\"unix://\$HOME/.dsh/docker.sock\"
    fi
    # Bound what one tenant can consume inside its own process tree. Without
    # these, a fork bomb or a multi-gigabyte file slows every other tenant,
    # which is itself a signal that somebody else is there.
    ulimit -u 1024 2>/dev/null || true
    ulimit -n 4096 2>/dev/null || true
    ulimit -f 2097152 2>/dev/null || true
    cd \"\$HOME/workspace\" 2>/dev/null || cd \"\$HOME\"
    exec /usr/bin/setpriv \
      --no-new-privs \
      --bounding-set=-all \
      --inh-caps=-all \
      --ambient-caps=-all \
      --reuid=\"$VH_JAIL_UID\" --regid=\"$VH_JAIL_UID\" --init-groups \"\$@\"
  " sh "$@"
' -- "$@"
