#!/usr/bin/env bash
# Run one tenant's dsh inside a mount + pid + ipc + uts + pivot_root jail.
#
# The jail layout mirrors an ordinary Linux server:
#
#   /home/<account>     the tenant's own content (bound from the data root)
#   /usr /bin /lib ...  shared runtime, mounted read-only
#   (nothing else)
#
# Everything bound in is an allow-list. The container's /etc, /dev and /proc are
# shared by every tenant, so rbinding a whole directory would hand one tenant
# whatever that directory happens to expose to the others: /etc/passwd lists
# every account, /dev/shm is one writable tmpfs for the whole container. Only the
# named entries below are reachable, and identity files are generated per tenant.
#
# The hostname is set per account so the prompt reads `vh-xxxx@dsh:~` instead of
# exposing the container id, and `cd ..` from the tenant home stops at the
# data root holding only that tenant
# because nothing above it exists.
#
# Requires CAP_SYS_ADMIN plus unconfined seccomp, declared in the app manifest.
#
# Usage: vh-jail <account> <uid> <home> <command...>
set -euo pipefail

HOME_ROOT="${HOME_ROOT:-/data}"
SKILLS_ROOT="${BUNDLED_SKILL_DIR:-/opt/v-harness/skills}"
JAIL_HOSTNAME="${VH_JAIL_HOSTNAME:-dsh}"

die() { printf 'vh-jail: %s\n' "$*" >&2; exit 1; }

[[ "${EUID}" -eq 0 ]] || die 'must run as root'

account="${1:-}"
uid="${2:-}"
home="${3:-}"
shift 3 || die 'usage: vh-jail <account> <uid> <home> <command...>'

[[ "$account" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid account: ${account}"
[[ "$uid" =~ ^[0-9]+$ ]] || die "invalid uid: ${uid}"
[[ "$home" == "${HOME_ROOT}/${account}" ]] || die "home must be ${HOME_ROOT}/${account}: ${home}"
[[ -d "$home" ]] || die "home does not exist: ${home}"

# The data root must stay traversable or every tenant write below it fails with
# EACCES no matter how correct the home permissions are. Boot does this too,
# but the volume mode has been observed to change after boot (the platform
# resets it on the host), and boot runs only once.
chmod 0711 "${HOME_ROOT}" 2>/dev/null \
  || printf "vh-jail: could not keep %s traversable\n" "${HOME_ROOT}" >&2

export VH_JAIL_ACCOUNT="$account"
export VH_JAIL_UID="$uid"
export VH_JAIL_HOME="$home"
export VH_JAIL_SKILLS="$SKILLS_ROOT"
export VH_JAIL_HOSTNAME="$JAIL_HOSTNAME"

# --mount-proc gives the pid namespace its own /proc, so `ps` only lists this
# user's processes. --fork is required for --pid to take effect. --ipc drops the
# shared System V / POSIX IPC key space, which would otherwise let two tenants
# attach to the same 0666 shared-memory segment. --uts exists only so the
# hostname below stays inside this session.
unshare --mount --pid --ipc --uts --fork --mount-proc bash -c '
  set -euo pipefail
  cd /
  # Keep these mounts inside this namespace; propagating them would corrupt the
  # container for every other user.
  mount --make-rprivate /
  hostname "$VH_JAIL_HOSTNAME" 2>/dev/null || true

  # Network isolation on the shared container network. Every tenant lives in
  # the one network namespace, so the kernel has to say what stays reachable.
  # Each tenant gets its own loopback address (encoded from the never-reused
  # uid; gateway/addressing.mjs computes the same value for the dsh bind) and
  # a per-uid policy: the tenant may talk to its own address, the gateway, and
  # its DNS resolver; the rest of 127/8 and the RFC1918 ranges (container
  # bridges of other tenants, the host-facing docker gateway) drop.
  #
  # Two engines, one policy, because neither can express it alone on this host:
  #   * `iptables -m owner --uid-owner` needs xt_owner; the deployment kernel
  #     does not ship it (modinfo: Module xt_owner not found), so that match
  #     can never load and the chain built this way was never attached. That
  #     is the "Extension owner revision 0 not supported" warning.
  #   * the native nftables `ct` needs nft_ct, which is missing as well, so the
  #     stateful half (replies addressed to the gateway) cannot be written in
  #     nft alone.
  # The bridge is a packet mark: an nftables chain (native `meta skuid`, needs
  # no kernel module) stamps every packet this uid emits, and the iptables
  # chain matches that mark with the ordinary conntrack match. The nft hook
  # runs at mangle priority, ahead of the filter chain, so the mark is always
  # in place before the policy sees the packet.
  #
  # Fails closed: this is the tenant boundary, so a rule that cannot be
  # installed refuses the start instead of running without it.
  net_isolate() {
    # The tenant address is exported whether or not the rules can be
    # installed: services and ad-hoc listeners have to bind it (or 0.0.0.0)
    # and the agent reaches them there.
    local tenant_ip="127.$(( VH_JAIL_UID / 256 % 256 )).$(( VH_JAIL_UID % 256 )).1"
    export VH_TENANT_IP="$tenant_ip"
    local chain="vh-uid-${VH_JAIL_UID}"
    local gw_port="${VH_GATEWAY_PORT:-8080}"
    # Bit 30 keeps this mark clear of the ones docker puts on bridge traffic.
    local mark
    mark="$(printf "0x%x" $(( 0x40000000 + VH_JAIL_UID )))"
    local ns handle
    warn() { printf "vh-jail: %s\n" "$1" >&2; }
    # This body runs in its own shell, so the outer die is not in scope.
    fail() { printf "vh-jail: %s\n" "$1" >&2; exit 1; }

    command -v iptables >/dev/null 2>&1 \
      || fail "iptables not found; network isolation cannot be installed"
    command -v nft >/dev/null 2>&1 \
      || fail "nft not found (the image must install nftables); network isolation cannot be installed"

    # --- nftables: stamp the packets of this uid with the mark -------------
    # `mark` is an nft keyword, so the chain is named stamp.
    nft list table inet vh >/dev/null 2>&1 || nft add table inet vh \
      || fail "cannot create the nft table; network isolation cannot be installed"
    nft list chain inet vh stamp >/dev/null 2>&1 \
      || nft add chain inet vh stamp "{ type filter hook output priority -150; }" \
      || fail "cannot create the nft stamp chain; network isolation cannot be installed"
    # Replace the previous stamp of this uid, whatever relaunched before.
    for handle in $(nft -a list chain inet vh stamp 2>/dev/null \
      | grep -F "meta skuid $VH_JAIL_UID " | sed -n "s/.*# handle \([0-9]*\)/\1/p"); do
      nft delete rule inet vh stamp handle "$handle" \
        || fail "cannot replace the mark rule (handle $handle)"
    done
    nft add rule inet vh stamp meta skuid "$VH_JAIL_UID" meta mark set "$mark" \
      || fail "cannot stamp this uid; network isolation cannot be installed"

    # --- iptables: the policy, matched on that mark ------------------------
    # -w waits for the xtables lock: two jails starting together otherwise
    # race and fail closed on the same rule. Capture stderr so a failure names
    # the kernel or frontend reason, not just the command that was attempted.
    must() {
      local err
      err="$("$@" 2>&1 >/dev/null)" || fail "network isolation failed: $*: ${err:-no stderr}"
      [ -z "$err" ] || printf "%s\n" "$err" >&2
    }
    iptables -w -L "$chain" -n >/dev/null 2>&1 || must iptables -w -N "$chain"
    must iptables -w -F "$chain"
    # Replies ride the same chain: on the loopback the listener and the client
    # share one uid, so the answer to a connection this tenant opened crosses
    # OUTPUT again, addressed to an ephemeral port on 127.0.0.1. Established
    # traffic passes before every drop; a NEW connection still has to match
    # the allow-list below.
    must iptables -w -A "$chain" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    # Own loopback world: the instance, the services, everything the tenant
    # binds on its own address.
    must iptables -w -A "$chain" -d "$tenant_ip" -j ACCEPT
    # The resolvers the jail binds in. Match the ORIGINAL destination port of
    # the connection: docker rewrites 127.0.0.11:53 to an ephemeral port in
    # nat OUTPUT before this filter chain runs, so a plain --dport 53 never
    # matches there.
    for ns in $(awk "/^nameserver /{print \$2}" /etc/resolv.conf 2>/dev/null); do
      must iptables -w -A "$chain" -d "$ns" -p udp -m conntrack --ctorigdstport 53 -j ACCEPT
      must iptables -w -A "$chain" -d "$ns" -p tcp -m conntrack --ctorigdstport 53 -j ACCEPT
    done
    # The gateway: model calls and scheduled follow-ups dial it from here.
    must iptables -w -A "$chain" -d 127.0.0.1 -p tcp --dport "$gw_port" -j ACCEPT
    # Deployment-supplied exceptions stay narrow and explicit (CIDR list).
    if [ -n "${VH_NET_ALLOW_CIDRS:-}" ]; then
      local cidr
      for cidr in $(printf "%s" "$VH_NET_ALLOW_CIDRS" | tr "," " "); do
        iptables -w -A "$chain" -d "$cidr" -j ACCEPT || warn "could not allow $cidr"
      done
    fi
    # Everything else on the loopback: instances, services and ad-hoc
    # listeners of other tenants, whatever address they bound.
    must iptables -w -A "$chain" -d 127.0.0.0/8 -j DROP
    # Private ranges: container bridges of other tenants and the host-facing
    # docker gateway (172.16/12), plus the pools docker hands out besides it.
    must iptables -w -A "$chain" -d 172.16.0.0/12 -j DROP
    must iptables -w -A "$chain" -d 192.168.0.0/16 -j DROP
    must iptables -w -A "$chain" -d 10.0.0.0/8 -j DROP
    # Attach the policy to this mark, exactly once, whatever relaunched before.
    while iptables -w -D OUTPUT -m mark --mark "$mark" -j "$chain" 2>/dev/null; do :; done
    must iptables -w -A OUTPUT -m mark --mark "$mark" -j "$chain"
    # No tenant address space on ::1: the whole IPv6 loopback drops. External
    # IPv6 destinations are untouched.
    #
    # The probe asks the kernel a real question, because the command merely
    # existing proves nothing: a host with IPv6 disabled (`ipv6.disable=1`, or
    # `net.ipv6.conf.all.disable_ipv6=1`) still ships ip6tables, and every rule
    # it takes then fails with "Address family not supported by protocol". That
    # must not refuse a launch — this deployment has nothing on ::1 to protect,
    # and the isolation it does need is already installed above. Where IPv6 does
    # work, the rule is mandatory like its IPv4 counterpart.
    if command -v ip6tables >/dev/null 2>&1 && ip6tables -w -L OUTPUT -n >/dev/null 2>&1; then
      while ip6tables -w -D OUTPUT -m mark --mark "$mark" -d ::1 -j DROP 2>/dev/null; do :; done
      must ip6tables -w -A OUTPUT -m mark --mark "$mark" -d ::1 -j DROP
    else
      warn "IPv6 is not available on this host; skipping the ::1 policy"
    fi
  }
  net_isolate


  # The jail root is a fresh tmpfs; only what is bound below is reachable.
  root="/run/vh-root-$VH_JAIL_ACCOUNT"
  rm -rf "$root"
  mkdir -p "$root"
  mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$root"

  # Bind one allow-listed entry read-only. Directories are re-bound (not
  # recursively) so an unexpected submount on the host stays out of the jail.
  bind_ro() {
    local source="/$1" target="$root/$1"
    [[ -e "$source" ]] || return 0
    mkdir -p "$(dirname "$target")"
    if [[ -d "$source" ]]; then
      mkdir -p "$target"
      mount --bind "$source" "$target"
    else
      touch "$target"
      mount --bind "$source" "$target"
    fi
    mount -o remount,bind,ro "$target"
  }

  # Public read-only runtime, exactly like a shared server. /usr is one unit
  # because the loader, Node, dsh and its native modules all live under it.
  bind_ro usr

  # Debian merged-/usr layout: /bin, /lib, /lib64 and /sbin are symlinks into
  # /usr. The new root has to recreate them or the dynamic loader is missing.
  for pair in bin:usr/bin lib:usr/lib lib64:usr/lib64 sbin:usr/sbin; do
    name="${pair%%:*}"
    target="${pair#*:}"
    if [[ -e "/$name" ]]; then
      ln -sfn "$target" "$root/$name"
    fi
  done

  # The container /etc is shared with every tenant, so the whole directory never
  # comes in. What is bound are the files a running process genuinely resolves
  # (loader cache, TLS roots, timezone, NSS) and nothing else: no /etc/shadow,
  # no /etc/sudoers, no /etc/ld.so.preload. Identity files are written below.
  mkdir -p "$root/etc"
  # chromium.d is not optional: /usr/bin/chromium is a shell wrapper that sources
  # every file in it, and a missing directory aborts the wrapper before the
  # browser starts ("cannot open /etc/chromium.d/*"), which reads as a broken
  # browser. fonts/ is here for the same reason as the CJK packages: without
  # the fontconfig directory a page of Chinese renders as tofu in the jail.
  for entry in \
    ld.so.cache ld.so.conf ld.so.conf.d alternatives \
    ssl/certs ssl/openssl.cnf \
    nsswitch.conf localtime timezone \
    mime.types services protocols \
    profile profile.d bash.bashrc bash_completion.d inputrc \
    terminfo gitconfig chromium.d fonts; do
    bind_ro "etc/$entry"
  done
  ln -sfn /proc/mounts "$root/etc/mtab"

  # Identity as this tenant sees it: the account itself, and localhost only.
  # A missing getpwuid entry breaks os.userInfo() and every group lookup, so the
  # tenant must be present; the rest of the container must not be.
  printf "%s:x:%s:%s::/home/%s:/usr/sbin/nologin\n" \
    "$VH_JAIL_ACCOUNT" "$VH_JAIL_UID" "$VH_JAIL_UID" "$VH_JAIL_ACCOUNT" \
    > "$root/etc/passwd"
  printf "%s:x:%s:\n" "$VH_JAIL_ACCOUNT" "$VH_JAIL_UID" > "$root/etc/group"
  printf "%s\n" "$VH_JAIL_ACCOUNT" > "$root/etc/hostname"
  printf "127.0.0.1 localhost\n::1 localhost ip6-localhost ip6-loopback\n" \
    > "$root/etc/hosts"
  chmod 0644 "$root/etc/passwd" "$root/etc/group" "$root/etc/hosts" "$root/etc/hostname"
  # DNS is not a jail concern (the container network is shared by design) but
  # name resolution is required by every model call, so the resolver comes in.
  bind_ro etc/resolv.conf

  # Product skills, read-only, at the path DSH_BUNDLED_SKILL_DIR promises.
  mkdir -p "$root$VH_JAIL_SKILLS"
  mount --bind "$VH_JAIL_SKILLS" "$root$VH_JAIL_SKILLS"
  mount -o remount,bind,ro "$root$VH_JAIL_SKILLS"

  # Devices: a fresh tmpfs with the nodes a process actually needs. The container
  # /dev is shared, and rbinding it would carry /dev/shm (one writable 64MB
  # tmpfs for the whole container) and a view of the pty of every other tenant.
  mkdir -p "$root/dev" "$root/proc" "$root/tmp" "$root/run"
  mount -t tmpfs -o mode=0755,nosuid tmpfs "$root/dev"
  for node in null:1:3 zero:1:5 full:1:7 random:1:8 urandom:1:9 tty:5:0; do
    node_name="${node%%:*}"
    rest="${node#*:}"
    mknod -m 0666 "$root/dev/$node_name" c "${rest%%:*}" "${rest#*:}"
  done
  mkdir -p "$root/dev/pts" "$root/dev/shm"
  # A private devpts instance: ptys allocated inside the jail are numbered here
  # and stay invisible to the host and to other tenants.
  mount -t devpts -o newinstance,ptmxmode=0666,mode=0620,gid=5 devpts "$root/dev/pts"
  ln -sfn pts/ptmx "$root/dev/ptmx"
  # Private scratch, so the classic cross-tenant tmpfs is not shared.
  mount -t tmpfs -o mode=1777,nosuid,nodev,size=64m tmpfs "$root/dev/shm"
  ln -sfn /proc/self/fd "$root/dev/fd"
  ln -sfn /proc/self/fd/0 "$root/dev/stdin"
  ln -sfn /proc/self/fd/1 "$root/dev/stdout"
  ln -sfn /proc/self/fd/2 "$root/dev/stderr"

  # A fresh proc rather than a recursive bind of the container one: the bind
  # would also carry /proc/sys and leave it read-write. Inside the pid namespace
  # this instance lists only this tenant.
  mount -t proc -o nosuid,nodev,noexec proc "$root/proc"


  # Bounded private scratch: an unbounded tmpfs lets one tenant exhaust the
  # container memory and slow every other tenant down — which is itself a way to
  # learn that someone else is there.
  mount -t tmpfs -o mode=1777,nosuid,nodev,size=512m tmpfs "$root/tmp"
  mount -t tmpfs -o mode=0755,nosuid,nodev,size=16m tmpfs "$root/run"
  # No private network any more: the jail shares the loopback and resolver of
  # the container, both bound in above, so DNS needs no forwarder or rewrite.

  # The tenant home at /home/<account>: a private /home means a sibling tenant
  # is not merely unreadable but nonexistent, and nothing creates /data, so a
  # probe of it answers ENOENT instead of a permission error.
  mkdir -p "$root/home/$VH_JAIL_ACCOUNT"
  mount --bind "$VH_JAIL_HOME" "$root/home/$VH_JAIL_ACCOUNT"
  chmod 0700 "$root/home/$VH_JAIL_ACCOUNT"

  # Everything above is root-side setup. pivot_root, not chroot: a chrooted
  # process cannot create a user namespace on this kernel, which is exactly what
  # bwrap needs for the dsh second confinement layer. Detaching the old root
  # makes the allow-listed tmpfs the mount namespace root, so the tenant still
  # cannot see the container tree or another tenant home.
  # The bounding set, inheritable set and ambient set are dropped too: the
  # container runs with SYS_ADMIN and unconfined seccomp for vh-jail itself, and
  # that posture must not be inherited by the tenant. --no-new-privs keeps a
  # setuid binary inside the home from reintroducing privilege.
  mkdir -p "$root/oldroot"
  cd "$root"
  pivot_root . oldroot || { echo "vh-jail: pivot_root failed" >&2; exit 97; }
  umount -l /oldroot || { echo "vh-jail: could not detach the old root" >&2; exit 97; }
  rmdir /oldroot 2>/dev/null || true
  exec /bin/sh -c "
    # Fail closed: if the world below is not the isolated one, do not start at
    # all. A degraded start is indistinguishable from a leak until it is too
    # late, so it is treated as a refusal.
    fail() { printf \"vh-jail: isolation check failed: %s\n\" \"\$1\" >&2; exit 97; }
    [ \"\$(wc -l < /etc/passwd)\" -eq 1 ] || fail \"etc/passwd lists more than one account\"
    [ \"\$(ls /home | wc -l)\" -eq 1 ] || fail \"the home root lists more than one tenant\"
    [ \"\$(ls /home)\" = \"$VH_JAIL_ACCOUNT\" ] || fail \"the home root does not name this tenant\"
    if [ -e /data ]; then fail \"the data root is visible\"; fi
    if [ -e /root ]; then fail \"the root home is visible\"; fi
    if grep -q \" /oldroot \" /proc/mounts; then fail \"the old root is still mounted\"; fi
    if [ -d /oldroot ] && [ -n \"\$(ls -A /oldroot 2>/dev/null)\" ]; then fail \"the old root is still reachable\"; fi
    export HOME=\"/home/$VH_JAIL_ACCOUNT\"
    export USER=\"$VH_JAIL_ACCOUNT\"
    export LOGNAME=\"$VH_JAIL_ACCOUNT\"
    export HOSTNAME=\"$VH_JAIL_HOSTNAME\"
    # User-level installs land in the tenant home, exactly like a plain server:
    # the system runtime is read-only, so npm/pip/cargo must be pointed at
    # writable prefixes under \$HOME, and those prefixes must be on PATH or the
    # command a tenant just installed is not found.
    export NPM_CONFIG_PREFIX=\"\$HOME/.npm-global\"
    export CONDA_PKGS_DIRS=\"\$HOME/.cache/conda\"
    # Plugins that resolve their store from an XDG root instead of DSH_HOME
    # must land in the tenant home too: a root inherited from the gateway
    # would be one directory shared by every tenant.
    export XDG_CONFIG_HOME=\"\$HOME/.config\"
    export XDG_DATA_HOME=\"\$HOME/.local/share\"
    export XDG_CACHE_HOME=\"\$HOME/.cache\"
    export XDG_STATE_HOME=\"\$HOME/.local/state\"
    export PATH=\"\$HOME/.npm-global/bin:\$HOME/.local/bin:\$HOME/.cargo/bin:\$HOME/.bun/bin:\$HOME/.nvm/current/bin:/usr/local/bin:/usr/bin:/bin\"
    # The tenant gets a real docker CLI pointed at the filtered endpoint the
    # gateway publishes. The host socket itself is never mounted, so this is
    # the only path from here to the daemon. The gateway publishes that socket
    # a moment after this jail starts, so the path is set unconditionally: an
    # existence guard here would leave every session launched before the
    # publish without a DOCKER_HOST until the tenant signs in again. No single
    # quotes in this block: the body is one single-quoted string.
    export DOCKER_HOST=\"unix://\$HOME/.dsh/docker.sock\"
    # Bound what one tenant can consume inside its own process tree. Without
    # these, a fork bomb or a multi-gigabyte file slows every other tenant,
    # which is itself a signal that somebody else is there.
    ulimit -u 1024 2>/dev/null || true
    ulimit -n 4096 2>/dev/null || true
    ulimit -f 2097152 2>/dev/null || true
    cd \"\$HOME/workspace\" 2>/dev/null || cd \"\$HOME\"
    # dsh fails closed when bwrap cannot confine (this kernel has no Landlock),
    # so verify the backend with the exact tenant credentials before launch.
    # A root-side probe would pass with CAP_SYS_ADMIN and hide a broken jail.
    /usr/bin/timeout 10 /usr/bin/setpriv \
      --no-new-privs \
      --bounding-set=-all \
      --inh-caps=-all \
      --ambient-caps=-all \
      --reuid=\"$VH_JAIL_UID\" --regid=\"$VH_JAIL_UID\" --init-groups \
      /usr/bin/bwrap --ro-bind / / --unshare-pid --unshare-ipc --proc /proc --die-with-parent --dev /dev -- /usr/bin/true \
      || fail \"no usable sandbox backend in the tenant jail\"
    echo \"vh-jail: tenant sandbox backend verified (bwrap)\" >&2
    exec /usr/bin/setpriv \
      --no-new-privs \
      --bounding-set=-all \
      --inh-caps=-all \
      --ambient-caps=-all \
      --reuid=\"$VH_JAIL_UID\" --regid=\"$VH_JAIL_UID\" --init-groups \"\$@\"
  " sh "$@"
' -- "$@"
