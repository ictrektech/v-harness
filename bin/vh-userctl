#!/usr/bin/env bash
# Root-side helper for v-harness. The gateway runs it through a fixed-path
# sudoers entry and never touches user directories itself.
#
# Every command is idempotent: re-running `ensure` after a container rebuild
# re-adopts the existing volume instead of replacing it.
#
# Layout: one tenant = one account = /home/<account>. The home root itself is
# 0700 root, so a tenant cannot even traverse into a sibling's name.
set -euo pipefail

HOME_ROOT="${HOME_ROOT:-/home}"
NAME_RE='^[a-z_][a-z0-9_-]{0,31}$'

die() { printf 'vh-userctl: %s\n' "$*" >&2; exit 1; }

require_root() {
  [[ "${EUID}" -eq 0 ]] || die 'must run as root'
}

# ensure <account> <uid> <home>
ensure() {
  local name="${1:-}" uid="${2:-}" home="${3:-}"

  [[ "$name" =~ $NAME_RE ]] || die "invalid account name: ${name}"
  [[ "$uid" =~ ^[0-9]+$ ]] || die "invalid uid: ${uid}"
  (( uid >= 20000 && uid <= 59999 )) || die "uid out of range: ${uid}"
  [[ "$home" == "${HOME_ROOT}/${name}" ]] || die "home must be ${HOME_ROOT}/${name}: ${home}"

  if ! getent group "$uid" >/dev/null 2>&1; then
    groupadd -g "$uid" --system "$name"
  fi
  if ! getent passwd "$name" >/dev/null 2>&1; then
    useradd -u "$uid" -g "$uid" --no-create-home --home "$home" \
      --shell /usr/sbin/nologin "$name"
  fi

  # Rebuild the layout without deleting anything: the volume may already hold
  # sessions, plugins and workspace files from a previous container.
  mkdir -p "$home" "$home/.dsh" "$home/.agents" "$home/workspace"
  # The default landing directory for chats without a project.
  mkdir -p "$home/workspace/日常"
  # User-level tool prefixes, pre-created and owned by the account so the first
  # `npm i -g` / `pip install --user` cannot fail on a root-owned path.
  mkdir -p "$home/.npm-global/bin" "$home/.local/bin" "$home/.local/lib" \
    "$home/.local/share" "$home/.local/state" "$home/.config" \
    "$home/.cargo/bin" "$home/.bun/bin" "$home/.nvm/current/bin" "$home/.cache"

  # The home root is closed: a tenant reaches its own home through the jail's
  # bind mount, never by walking this directory. A sibling's name is therefore
  # not merely unreadable but undiscoverable.
  chmod 0700 "$HOME_ROOT"
  chown root:root "$HOME_ROOT"
  chown "$name:$name" "$home"
  # Tighten only: never widen an existing mode.
  chmod 0700 "$home"
  chown -R "$name:$name" "$home/.dsh" "$home/.agents" "$home/workspace" \
    "$home/.npm-global" "$home/.local" "$home/.config" \
    "$home/.cargo" "$home/.bun" "$home/.nvm" "$home/.cache"
  chmod 0700 "$home/.dsh" "$home/.agents"
}

# claim <account> <socketPath>
#
# The gateway creates a tenant's capability sockets as root; the owner of the
# account must be the only one able to connect to them. Only the listed socket
# names under a tenant home are accepted, so this cannot become a
# general-purpose chown.
claim() {
  local name="${1:-}" path="${2:-}"

  [[ "$name" =~ $NAME_RE ]] || die "invalid account name: ${name}"
  case "$path" in
    "${HOME_ROOT}/${name}/.dsh/voffice.sock"|"${HOME_ROOT}/${name}/.dsh/album.sock"|"${HOME_ROOT}/${name}/.dsh/weknora.sock"|"${HOME_ROOT}/${name}/.dsh/photocraft.sock") ;;
    *) die "unexpected claim path: ${path}" ;;
  esac
  [[ -S "$path" ]] || die "not a socket: ${path}"
  getent passwd "$name" >/dev/null 2>&1 || die "unknown account: ${name}"

  chown "$name:$name" "$path"
  chmod 0600 "$path"
}

main() {
  local command="${1:-}"
  [[ -n "$command" ]] || die 'usage: vh-userctl ensure <name> <uid> <home> | claim <name> <socket>'
  require_root
  case "$command" in
    ensure)
      shift
      ensure "$@"
      ;;
    claim)
      shift
      claim "$@"
      ;;
    *)
      die "unknown command: ${command}"
      ;;
  esac
}

main "$@"
